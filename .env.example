# Copy to .env and fill (gitignored; config.yaml also works)

# --- LLM（OpenAI 兼容接口）---
# 必填：对话/抽取用
LLM_API_KEY=
# 可选：默认 https://api.deepseek.com/v1 + deepseek-chat
# 例（硅基流动托管 DeepSeek）：https://api.siliconflow.cn/v1 + deepseek-ai/DeepSeek-V4-Flash
LLM_BASE_URL=
LLM_MODEL=

# --- 硅基流动（embedding / reranker）---
# https://cloud.siliconflow.cn  BAAI/bge-m3 + BAAI/bge-reranker-v2-m3
SILICONFLOW_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
RERANK_MODEL=

# --- SMTP（发送邮件，人工确认后才会用到）---
SMTP_PASSWORD=
SMTP_EMAIL=
SMTP_SERVER=smtp.example.com
SMTP_PORT=465

# Copy to .env and fill (gitignored; config.yaml also works)

# --- LLM（OpenAI 兼容接口）---
# DeepSeek: https://platform.deepseek.com  默认对话/抽取模型
DEEPSEEK_API_KEY=
# 覆盖默认 base_url / 模型（可选，默认 https://api.deepseek.com + deepseek-chat）
LLM_BASE_URL=
LLM_MODEL=

# --- 硅基流动（embedding / reranker）---
# https://cloud.siliconflow.cn  BAAI/bge-m3 + BAAI/bge-reranker-v2-m3
SILICONFLOW_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
RERANK_MODEL=

# --- SMTP（发送邮件，人工确认后才会用到）---
SMTP_PASSWORD=
SMTP_EMAIL=
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
